TARGET = @TARGET@

PROFILE = @PROFILE@
FEATURE_FLAGS = @FEATURE_FLAGS@

VCPKG_ROOT = @VCPKG_ROOT@
VCPKG_TARGET_TRIPLET = @VCPKG_TARGET_TRIPLET@
VCPKG_OVERLAY_TRIPLETS = @VCPKG_OVERLAY_TRIPLETS@
VCPKG_MANIFEST_MODE = OFF
CMAKE_TOOLCHAIN_FILE = @CMAKE_TOOLCHAIN_FILE@
CMAKE_PREFIX_PATH = @CMAKE_PREFIX_PATH@
OPENSSL_ROOT_DIR = @OPENSSL_ROOT_DIR@
SPATIAL_VCPKG_PREFIX = @SPATIAL_VCPKG_PREFIX@
GDAL_VERSION = @GDAL_VERSION@
SEDONADB_R_CC = $(strip $(CC))
SEDONADB_R_CXX = $(strip $(CXX17))
SEDONADB_R_CFLAGS = $(CPPFLAGS) $(CFLAGS)
SEDONADB_R_CXXFLAGS = $(CPPFLAGS) $(CXX17FLAGS)
SEDONADB_R_LDFLAGS = $(LDFLAGS)

# Add flags if necessary
RUSTFLAGS =

# We set this in configure to work around a Windows path length restriction
TARGET_DIR = @TARGET_DIR@
LIBDIR = $(TARGET_DIR)/$(TARGET)/$(subst dev,debug,$(PROFILE))
STATLIB = $(LIBDIR)/libsedonadbr.a
S2_R_LINK_FLAGS = $(LIBDIR)/sedonadb-s2-r-link-flags.txt
S2_NATIVE_LIBS = $(if $(findstring s2geography,$(FEATURE_FLAGS)),$(shell test ! -f "$(S2_R_LINK_FLAGS)" || cat "$(S2_R_LINK_FLAGS)"))
# Supplement the generated flags with the leaf archives missing from the
# Rtools DLL link. This fallback is specific to R's pinned vcpkg package: keep
# Abseil implementation details here, outside the shared CMake/Rust builder.
# Keep these archives in the same rescan group as the generated flags.
S2_WINDOWS_ABSL_LIBS = -L$(CMAKE_PREFIX_PATH)/lib \
	-labsl_base \
	-labsl_log_internal_fnmatch \
	-labsl_raw_logging_internal \
	-labsl_spinlock_wait \
	-labsl_strings_internal \
	-labsl_throw_delegate \
	-labsl_time \
	-labsl_time_zone \
	-labsl_civil_time \
	-labsl_malloc_internal \
	-labsl_kernel_timeout_internal
S2_LINK_GROUP_START = -Wl,--start-group
S2_LINK_GROUP_END = -Wl,--end-group
S2_LINK_LIBS = $(if $(findstring s2geography,$(FEATURE_FLAGS)),$(S2_LINK_GROUP_START) $(S2_NATIVE_LIBS) $(S2_WINDOWS_ABSL_LIBS) $(S2_LINK_GROUP_END))
PKG_LIBS = -L$(LIBDIR) -lsedonadbr $(S2_LINK_LIBS) -lws2_32 -ladvapi32 -luserenv -lbcrypt -lntdll -lole32 @PKG_LIBS@

# Rtools doesn't have the linker in the location that cargo expects, so we need
# to overwrite it via configuration.
CARGO_LINKER = x86_64-w64-mingw32.static.posix-gcc.exe

# It seems pkg-config requires this envvar to be explicitly set in case of cross-compilation.
#
# cf. https://stackoverflow.com/a/68979087
PKG_CONFIG_SYSROOT_DIR = /x86_64-w64-mingw32.static.posix/

# cc appends environment CFLAGS after a crate's source-specific flags. Do not
# let R's optimization setting override aws-lc-sys's required -O0 for its
# jitterentropy source. Cargo still supplies the release-profile optimization
# level for other native dependencies.
#
# "-Wno-pedantic" overrides the "-pedantic" flag passed by pkgbuild, which is
# also incompatible with aws-lc-sys.
CFLAGS_TWEAKED = $(filter-out -O%,$(CFLAGS)) -Wno-pedantic

all: $(SHLIB) copy_native_data clean_intermediate

$(SHLIB): $(STATLIB)

$(STATLIB):
	# When the GNU toolchain is used (i.e. on CRAN), -lgcc_eh is specified for
	# building proc-macro2, but Rtools doesn't contain libgcc_eh. This isn't used
	# in actual, but we need this tweak to please the compiler.
	mkdir -p $(LIBDIR)/libgcc_mock && touch $(LIBDIR)/libgcc_mock/libgcc_eh.a

	export CARGO_TARGET_X86_64_PC_WINDOWS_GNU_LINKER="$(CARGO_LINKER)" && \
	  export LIBRARY_PATH="$${LIBRARY_PATH};$(LIBDIR)/libgcc_mock" && \
	  export PKG_CONFIG_SYSROOT_DIR="$(PKG_CONFIG_SYSROOT_DIR)" && \
	  if [ -n "$(SPATIAL_VCPKG_PREFIX)" ]; then \
	    export PKG_CONFIG_ALLOW_CROSS=1; \
	    export PKG_CONFIG_ALL_STATIC=1; \
	    export PKG_CONFIG_SYSROOT_DIR=""; \
	    export PKG_CONFIG_PATH="$(SPATIAL_VCPKG_PREFIX)/lib/pkgconfig:$(SPATIAL_VCPKG_PREFIX)/share/pkgconfig$${PKG_CONFIG_PATH:+:$${PKG_CONFIG_PATH}}"; \
	    export GDAL_STATIC=1; \
	    export GDAL_INCLUDE_DIR="$(SPATIAL_VCPKG_PREFIX)/include"; \
	    export GDAL_LIB_DIR="$(SPATIAL_VCPKG_PREFIX)/lib"; \
	    export GDAL_VERSION="$(GDAL_VERSION)"; \
	  fi && \
	  if [ -n "$(VCPKG_ROOT)" ]; then \
	    export VCPKG_ROOT="$(VCPKG_ROOT)"; \
	    export VCPKG_DEFAULT_TRIPLET="$(VCPKG_TARGET_TRIPLET)"; \
	    export VCPKG_TARGET_TRIPLET="$(VCPKG_TARGET_TRIPLET)"; \
	    export VCPKG_OVERLAY_TRIPLETS="$(VCPKG_OVERLAY_TRIPLETS)"; \
	    export VCPKG_MANIFEST_MODE="$(VCPKG_MANIFEST_MODE)"; \
	    export CMAKE_TOOLCHAIN_FILE="$(CMAKE_TOOLCHAIN_FILE)"; \
	    export CMAKE_PREFIX_PATH="$(CMAKE_PREFIX_PATH)"; \
	    export OPENSSL_ROOT_DIR="$(OPENSSL_ROOT_DIR)"; \
	    export CMAKE_GENERATOR="Unix Makefiles"; \
	    export SEDONADB_R_CC="$(SEDONADB_R_CC)"; \
	    export SEDONADB_R_CXX="$(SEDONADB_R_CXX)"; \
	    export SEDONADB_R_CFLAGS="$(SEDONADB_R_CFLAGS)"; \
	    export SEDONADB_R_CXXFLAGS="$(SEDONADB_R_CXXFLAGS)"; \
	    export SEDONADB_R_LDFLAGS="$(SEDONADB_R_LDFLAGS)"; \
	    export SEDONADB_R_LINK_FLAGS_FILE="$(S2_R_LINK_FLAGS)"; \
	  fi && \
	  export CC="$(CC)" && \
	  export CFLAGS="$(CFLAGS_TWEAKED)" && \
	  export RUSTFLAGS="$(RUSTFLAGS)" && \
	  cargo build --target $(TARGET) --lib --profile $(PROFILE) $(FEATURE_FLAGS) --manifest-path ./rust/Cargo.toml --target-dir $(TARGET_DIR)

clean_intermediate: $(SHLIB)
	rm -f $(STATLIB)

# GDAL and PROJ runtime data must match the vcpkg libraries bundled above.
# Copying these trees follows the Windows packaging pattern used by sf/vapour.
copy_native_data:
	if [ -n "$(SPATIAL_VCPKG_PREFIX)" ]; then \
	  test -d "$(SPATIAL_VCPKG_PREFIX)/share/gdal"; \
	  test -d "$(SPATIAL_VCPKG_PREFIX)/share/proj"; \
	  rm -rf ../inst/gdal ../inst/proj; \
	  cp -R "$(SPATIAL_VCPKG_PREFIX)/share/gdal" ../inst/gdal; \
	  cp -R "$(SPATIAL_VCPKG_PREFIX)/share/proj" ../inst/proj; \
	fi

clean:
	rm -Rf $(SHLIB) $(OBJECTS) $(STATLIB) ./rust/target

.PHONY: all copy_native_data clean_intermediate clean
