TARGET = @TARGET@

PROFILE = @PROFILE@
FEATURE_FLAGS = @FEATURE_FLAGS@
VCPKG_ROOT = @VCPKG_ROOT@
VCPKG_DEFAULT_TRIPLET = @VCPKG_DEFAULT_TRIPLET@
VCPKG_TARGET_TRIPLET = @VCPKG_TARGET_TRIPLET@
VCPKG_OVERLAY_TRIPLETS = @VCPKG_OVERLAY_TRIPLETS@
VCPKG_MANIFEST_MODE = @VCPKG_MANIFEST_MODE@
CMAKE_TOOLCHAIN_FILE = @CMAKE_TOOLCHAIN_FILE@
CMAKE_PREFIX_PATH = @CMAKE_PREFIX_PATH@
OPENSSL_ROOT_DIR = @OPENSSL_ROOT_DIR@

# Add flags if necessary
RUSTFLAGS =

TARGET_DIR = $(CURDIR)/rust/target
LIBDIR = $(TARGET_DIR)/$(TARGET)/$(subst dev,debug,$(PROFILE))
STATLIB = $(LIBDIR)/libsedonadbr.a
S2_R_LINK_FLAGS = $(LIBDIR)/sedonadb-s2-r-link-flags.txt
S2_NATIVE_LIBS = $(if $(findstring s2geography,$(FEATURE_FLAGS)),$(shell test ! -f "$(S2_R_LINK_FLAGS)" || cat "$(S2_R_LINK_FLAGS)"))
PKG_LIBS = -L$(LIBDIR) -lsedonadbr $(S2_NATIVE_LIBS) @PKG_LIBS@

CARGO_BUILD_ARGS = --lib --profile $(PROFILE) $(FEATURE_FLAGS) --manifest-path=./rust/Cargo.toml --target-dir $(TARGET_DIR)

# "-Wno-pedantic" is to override the "-pedantic" flag passed by pkgbuild, which
# makes the compilation of aws-lc-sys fail. Hopefully, such C code will be fixed
# on upstream so that we can remove this.
CFLAGS_TWEAKED = $(CFLAGS) -Wno-pedantic

all: $(SHLIB) clean_intermediate

$(SHLIB): $(STATLIB)

$(STATLIB):
	# In some environments, ~/.cargo/bin might not be included in PATH, so we need
	# to set it here to ensure cargo can be invoked. It is appended to PATH and
	# therefore is only used if cargo is absent from the user's PATH.
	export PATH="$(PATH):$(HOME)/.cargo/bin" && \
	  export CC="$(CC)" && \
	  export CFLAGS="$(CFLAGS_TWEAKED)" && \
	  export AWS_LC_SYS_CMAKE_BUILDER=1 && \
	  export VCPKG_ROOT="$(VCPKG_ROOT)" && \
	  export VCPKG_DEFAULT_TRIPLET="$(VCPKG_DEFAULT_TRIPLET)" && \
	  export VCPKG_TARGET_TRIPLET="$(VCPKG_TARGET_TRIPLET)" && \
	  export VCPKG_OVERLAY_TRIPLETS="$(VCPKG_OVERLAY_TRIPLETS)" && \
	  export VCPKG_MANIFEST_MODE="$(VCPKG_MANIFEST_MODE)" && \
	  export CMAKE_TOOLCHAIN_FILE="$(CMAKE_TOOLCHAIN_FILE)" && \
	  export CMAKE_PREFIX_PATH="$(CMAKE_PREFIX_PATH)" && \
	  export OPENSSL_ROOT_DIR="$(OPENSSL_ROOT_DIR)" && \
	  export SEDONADB_R_LINK_FLAGS_FILE="$(S2_R_LINK_FLAGS)" && \
	  export RUSTFLAGS="$(RUSTFLAGS)" && \
	  if [ "$(TARGET)" != "wasm32-unknown-emscripten" ]; then \
	    cargo build $(CARGO_BUILD_ARGS); \
	  else \
	    export CARGO_PROFILE_DEV_PANIC="abort" && \
	    export CARGO_PROFILE_RELEASE_PANIC="abort" && \
	    export RUSTFLAGS="$(RUSTFLAGS) -Zdefault-visibility=hidden" && \
	    cargo +nightly build $(CARGO_BUILD_ARGS) --target $(TARGET) -Zbuild-std=panic_abort,std; \
	  fi

clean_intermediate: $(SHLIB)
	rm -f $(STATLIB)

clean:
	rm -Rf $(SHLIB) $(OBJECTS) $(STATLIB) ./rust/target

.PHONY: all clean_intermediate clean
